POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_business_os

# Comma-separated frontend origins allowed by CORS. Production sets this to
# the deployed frontend's URL (e.g. https://app.example.com) via SSM.
ALLOWED_ORIGINS=http://localhost:3000

# Clerk (see app/clerk_auth.py, app/dependencies.py's get_current_user).
# CLERK_JWKS_URL/CLERK_ISSUER come from the Clerk dashboard's API Keys page
# (the "JWKS URL" and the instance's Frontend API URL). CLERK_SECRET_KEY is
# only used by scripts/import_users_to_clerk.py, not by the running API.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-business-os-uploads-dev

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
MAPPING_CONFIDENCE_THRESHOLD=0.8

# "local" (default) uses structlog's human-readable console renderer;
# anything else (e.g. "prod") switches to JSON, which is what CloudWatch
# Logs Insights actually queries. See app/logging_config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Unset (the default) makes sentry_sdk.init a full no-op -- safe for local
# dev and CI. See app/observability.py.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Unset LANGFUSE_PUBLIC_KEY (the default) skips Langfuse init entirely --
# safe for local dev and CI. Fill in real values from a Langfuse project
# to get LLM tracing (prompt/completion/tokens/cost/latency) locally. See
# app/observability.py.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# Rate limiting (app/rate_limit.py). RATE_LIMIT_ENABLED=false is set
# unconditionally in tests/conftest.py, so the existing test suite never
# has to account for it. A separate logical Redis DB (not REDIS_URL's db
# 0, which is the Celery broker) so debugging one never resets the
# other's counters.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
RATE_LIMIT_DEFAULT=300/minute
# LLM/expensive endpoints -- cost circuit-breakers, not security.
RATE_LIMIT_CHAT=20/minute;300/day
RATE_LIMIT_REPORTS=10/hour
RATE_LIMIT_INSIGHTS=10/hour
RATE_LIMIT_UPLOADS=30/hour
RATE_LIMIT_DOCUMENTS=60/hour
RATE_LIMIT_WEBHOOK=120/minute

# WhatsApp Cloud API (app/whatsapp.py). Every value below unset (the
# default) makes is_configured() return False -- a true no-op safe for
# local dev/CI, same story as SENTRY_DSN/LANGFUSE_PUBLIC_KEY above. Fill
# these in from developers.facebook.com (WhatsApp product > API Setup)
# to exercise the real Cloud API locally -- see docs/decisions.md for the
# full setup walkthrough.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Invented, not issued by Meta -- must match whatever you paste into the
# webhook's "Verify token" field when subscribing (app/routers/webhooks.py's
# GET handler).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Cosmetic only (Settings page tells the owner what number to text) --
# never used in an API call.
WHATSAPP_DISPLAY_NUMBER=

# v0.6 slice 2 (app/outbound.py, app/insight_delivery.py): outbound
# infrastructure + proactive insight delivery. The template name/language
# must match a template actually approved in Meta's dashboard -- until
# one exists, any send outside the 24h session window fails at the Cloud
# API call (app/whatsapp.py's send_template), same "code is correct,
# live verification pending real Meta approval" situation as the rest of
# this channel. See docs/decisions.md.
WHATSAPP_INSIGHT_TEMPLATE_NAME=insight_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# How long since an identity's last digest before another is due.
WHATSAPP_DIGEST_INTERVAL_HOURS=24
# How often Celery beat CHECKS which identities are due -- distinct from
# the interval above. Defaults to 1h in code (app/celery_app.py); shrink
# for a demo/dev session the same way ANALYSIS_INTERVAL_SECONDS is.
WHATSAPP_DIGEST_DISPATCH_INTERVAL_SECONDS=3600
